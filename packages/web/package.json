{
  "name": "@pauseai-es/merch-web",
  "type": "module",
  "private": true,
  "version": "1.1.1",
  "description": "Web generator: pick a design and tee colour, add a logo, URL and text, download print-ready files",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 .",
    "og": "node scripts/og-images.ts",
    "docker:build": "docker buildx build ${DOCKER_PLATFORM:+--platform=$DOCKER_PLATFORM} -t \"${DOCKER_REGISTRY:+${DOCKER_REGISTRY}/}pauseai-es/merchandise:${npm_package_version}${DOCKER_TAG_SUFFIX:+.${DOCKER_TAG_SUFFIX}}\" -f ../../Dockerfile ../..",
    "docker:push": "docker push \"${DOCKER_REGISTRY:+${DOCKER_REGISTRY}/}pauseai-es/merchandise:${npm_package_version}${DOCKER_TAG_SUFFIX:+.${DOCKER_TAG_SUFFIX}}\"",
    "test": "echo 'no web tests yet; the rendering engine is tested in @pauseai-es/merch-core'"
  },
  "dependencies": {
    "@pauseai-es/merch-core": "workspace:*",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4"
  }
}
