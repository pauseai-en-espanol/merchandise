{
  "name": "pauseai-es-merchandise",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "Open-source merchandise designs for PauseAI en Español, plus the web generator that turns them into print-ready files",
  "scripts": {
    "dev": "pnpm --filter @pauseai-es/merch-web dev",
    "build": "pnpm --filter @pauseai-es/merch-web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --max-warnings 0 . && pnpm -r lint",
    "lint:fix": "oxlint --fix --max-warnings 0 . && pnpm -r lint:fix",
    "format": "prettier --ignore-unknown --write .",
    "format:check": "prettier --ignore-unknown --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "release:note": "changeset add",
    "release:empty": "changeset add --empty",
    "release:bump": "changeset version",
    "release:check": "changeset status --since=origin/main",
    "prepare": "[ \"$PACKAGED\" = true ] && echo 'Skipping prepare for packaged production dependencies install' || husky"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "26.12.0",
    "pnpm": "12.14.0"
  },
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@slango.configs/lint-staged": "2.0.9",
    "@slango.configs/oxlint": "0.1.14",
    "@slango.configs/prettier": "1.0.37",
    "@slango.configs/typescript": "3.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
