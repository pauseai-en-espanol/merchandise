{
  // Modelled on the aiontheballot repo's renovate.json5.
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:best-practices'],
  rangeStrategy: 'bump',
  dependencyDashboard: true,
  timezone: 'Europe/Madrid',
  // One weekly window, early on Monday, and open PRs aren't updated outside it either. Security fixes ignore it:
  // Renovate always raises vulnerability PRs at once, whatever the schedule. Lock-file maintenance
  // (config:best-practices) keeps its own PR, before 4am the same Monday.
  schedule: ['* 0-5 * * 1'],
  updateNotScheduled: false,
  // The window has one or two of the hosted app's runs: no hourly cap, so every PR due is opened in them.
  prHourlyLimit: 0,
  // Rebase only when a PR can no longer merge, not after every push to main.
  rebaseWhen: 'conflicted',
  // Supply-chain delay. pnpm-workspace.yaml keeps pnpm's shorter default for now: pnpm checks the lockfile against
  // its own minimumReleaseAge even on a frozen install, so raising it to 3 days needs a lockfile with no younger
  // entry.
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  // Security fixes bypass this minimumReleaseAge and are raised immediately; OSV scanning broadens vulnerability
  // detection beyond the platform's native alerts.
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      // Every non-major update in one PR a week. Listed after the presets' groups (monorepos and the like), so
      // their non-major updates join it too.
      groupName: 'Non-major updates',
      matchUpdateTypes: ['patch', 'pin', 'minor', 'digest', 'pinDigest'],
      automerge: false,
      groupSlug: 'non-major-updates',
      // Again here: Renovate's own defaults for pin updates would otherwise rebase the group on every push.
      rebaseWhen: 'conflicted',
      labels: ['dependencies', 'non-major'],
    },
    {
      matchUpdateTypes: ['major'],
      automerge: false,
      labels: ['dependencies', 'major'],
    },
    {
      // The design pipeline's Python packages (scripts/requirements.txt): an update may change every generated
      // file, so it gets a PR of its own, whatever the update's type. CI's "Generated designs" job fails if it
      // does; then run ./scripts/build-all.sh in the PR and commit the result. Mind the Python version too: CI runs
      // 3.12, and a newer package may not install on an older local Python. Listed after the groups above, so it
      // takes these packages out of them.
      matchManagers: ['pip_requirements'],
      groupName: 'Design pipeline (Python)',
      groupSlug: 'design-pipeline-python',
      automerge: false,
      labels: ['dependencies', 'design-pipeline'],
    },
    {
      matchManagers: ['github-actions'],
      labels: ['github-actions'],
    },
  ],
}
