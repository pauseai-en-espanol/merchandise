{
  // slango's shared preset for an application: one weekly window early on Monday, every non-major update in one PR,
  // a 3-day supply-chain delay, @slango/* as soon as it's released. Only this repository's own rules go here.
  // pnpm-workspace.yaml keeps pnpm's shorter default for now: pnpm checks the lockfile against its own
  // minimumReleaseAge even on a frozen install, so raising it to 3 days needs a lockfile with no younger entry.
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>danilupion/slango//renovate/app.json5'],
  packageRules: [
    {
      // The design pipeline's Python packages (scripts/requirements.txt): an update may change every generated
      // file, so it gets a PR of its own, whatever the update's type. CI's "Generated designs" job fails if it
      // does; then run ./scripts/build-all.sh in the PR and commit the result. Mind the Python version too: CI runs
      // 3.12, and a newer package may not install on an older local Python. Listed after the preset's groups, so it
      // takes these packages out of them.
      matchManagers: ['pip_requirements'],
      groupName: 'Design pipeline (Python)',
      groupSlug: 'design-pipeline-python',
      automerge: false,
      labels: ['dependencies', 'design-pipeline'],
    },
  ],
}
